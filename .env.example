# Copernicus Data Space Ecosystem OAuth client.
# Register for free at https://dataspace.copernicus.eu/ and create a client.
# Copy this file to .env (or set the variables in your shell) — never commit .env.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Local LM Studio: start the OpenAI-compatible server after loading Qwen.
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=qwen/qwen3.5-9b
# Optional Kazakh-interface model; defaults to LLM_MODEL when unset.
# LLM_MODEL_KK=qwen/qwen3.5-9b

# For Render/Groq, set the key as a secret in Render Environment.
# Without LLM_BASE_URL/LLM_MODEL, a configured key selects Groq defaults.
# LLM_API_KEY=
# Optional explicit overrides:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant

# The dashboard may export the same CDSE values as $id / $secret; both names work.

# Optional: force offline mode (demos still work, drawn contours fall back).
AGRO_DISABLE_NETWORK=0
